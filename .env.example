# ============================================================
# .env.example — HerpIA (RAN/ICMBio)
# ============================================================
# Copie este arquivo para .env e substitua os valores:
#   cp .env.example .env
#
# NUNCA versione o arquivo .env com valores reais.
# O .gitignore já está configurado para ignorá-lo.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=ran_chatbot
POSTGRES_USER=ran_user
POSTGRES_PASSWORD=change_me

# URL completa de conexão com o banco de dados
DATABASE_URL=postgresql://ran_user:change_me@localhost:5432/ran_chatbot

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ran_herpetofauna

# Enquanto o PC servidor não estiver configurado (docker-compose.yml + túnel SSH),
# defina QDRANT_LOCAL_PATH para rodar o Qdrant em modo embutido: sem Docker, sem
# rede, só um diretório local. Quando definido, QDRANT_URL é ignorado.
# Ver docs/processos/embeddings.md.
# QDRANT_LOCAL_PATH=07_processados/qdrant_local

# --- LLM de geração ---
# Decisão temporária (ADR 0006): LLM local via Ollama, sem custo de API,
# mesmo padrão do BGE-M3 (ADR 0005) e do VLM local da Fase 2.3 — enquanto
# não houver orçamento confirmado para API paga.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct

# Só usado se LLM_PROVIDER=openai (troca futura, se a equipe confirmar orçamento)
# OPENAI_API_KEY=coloque_sua_chave_aqui

# Verificação de groundedness pós-geração (backend/services/groundedness.py).
# Adiciona uma checagem lexical + uma chamada extra ao LLM como "juiz" antes
# de devolver a resposta — mais fiel, mas ~dobra a latência de /perguntar.
# Desative só para iteração rápida em desenvolvimento.
GROUNDEDNESS_VERIFICAR=true

# --- Configuração geral ---
APP_ENV=development
SERVER_DATA_DIR=./
