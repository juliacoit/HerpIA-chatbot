# ============================================================
# .env.example — Chatbot RAN/ICMBio
# ============================================================
# Copie este arquivo para .env e substitua os valores:
#   cp .env.example .env
#
# NUNCA versione o arquivo .env com valores reais.
# O .gitignore já está configurado para ignorá-lo.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=ran_chatbot
POSTGRES_USER=ran_user
POSTGRES_PASSWORD=change_me

# URL completa de conexão com o banco de dados
DATABASE_URL=postgresql://ran_user:change_me@localhost:5432/ran_chatbot

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ran_herpetofauna

# Enquanto o PC servidor não estiver configurado (docker-compose.yml + túnel SSH),
# defina QDRANT_LOCAL_PATH para rodar o Qdrant em modo embutido: sem Docker, sem
# rede, só um diretório local. Quando definido, QDRANT_URL é ignorado.
# Ver docs/processos/embeddings.md.
# QDRANT_LOCAL_PATH=07_processados/qdrant_local

# --- LLM / API externa ---
OPENAI_API_KEY=coloque_sua_chave_aqui

# --- Configuração geral ---
APP_ENV=development
SERVER_DATA_DIR=./
