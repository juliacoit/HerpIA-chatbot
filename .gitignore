# Ambiente Python
venv/
.venv/
env/

# Variáveis de ambiente e chaves
.env
.env.*
!.env.example
*.key
*.pem

# Cache Python
__pycache__/
*.pyc
.pytest_cache/

# Sistema
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Documentos binários coletados de fontes web (PDFs, planilhas etc.)
# Os metadados (JSON) com os links permanecem versionados.
01_fontes_web/**/documentos/

# Textos extraídos de PDFs (derivados de arquivos gitignored — regeneráveis pelo script)
# Exceção: salve/ é versionado porque as fichas-fonte JSON também estão no git.
07_processados/textos_extraidos/monitora/
07_processados/textos_extraidos/pans/

# Chunks e embeddings (gerados pelo pipeline — não versionar)
07_processados/chunks/
07_processados/metadados/

# Relatório gerado pelo script de download
01_fontes_web/pans/relatorio_download.json
01_fontes_web/monitora/relatorio_download.json

# Docker overrides locais (não versionar)
docker-compose.override.yml
docker-compose.local.yml

# Dados locais fora do Docker
data/
volumes/

# Logs
*.log
logs/
